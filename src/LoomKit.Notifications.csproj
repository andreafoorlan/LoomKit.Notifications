<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <Version>10.0.2</Version>
    <PackageId>LoomKit.Notifications</PackageId>
    <Authors>Andrea Furlan</Authors>
    <Description>A lightweight in-process notification/pub-sub library for .NET: dispatch notifications to zero or more DI-resolved handlers with an optional middleware pipeline.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/andreafoorlan/LoomKit.Notifications</PackageProjectUrl>
    <RepositoryUrl>https://github.com/andreafoorlan/LoomKit.Notifications</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>notifications;pubsub;events;dependency-injection;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 Andrea Furlan</Copyright>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LoomKit.Notifications.Abstractions" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
